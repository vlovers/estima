{
  "name": "@./source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:api": "node ./node_modules/nx/bin/nx.js serve api",
    "start:web": "node ./node_modules/nx/bin/nx.js serve web",
    "build:api": "node ./node_modules/nx/bin/nx.js build api",
    "build:web": "node ./node_modules/vite/bin/vite.js build --config web/vite.config.ts",
    "typeorm": "TS_NODE_PROJECT=api/tsconfig.app.json node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource api/src/database/data-source.ts",
    "typeorm:legacy": "TYPEORM_MIGRATION_CHAIN=legacy bun run typeorm",
    "typeorm:baseline": "TYPEORM_MIGRATION_CHAIN=baseline bun run typeorm",
    "typeorm:run-migrations": "bun run typeorm migration:run",
    "typeorm:revert-migration": "bun run typeorm migration:revert",
    "migration-test:db:up": "docker compose up -d postgres-migration-test",
    "migration-test:baseline": "MIGRATION_VALIDATION_TARGET=disposable-postgres-migration-validation MIGRATION_TEST_CONTAINER=ai-estimates-migration-test-db MIGRATION_TEST_HOST=127.0.0.1 MIGRATION_TEST_PORT=55432 MIGRATION_TEST_USERNAME=ai_estimator_migration_test MIGRATION_TEST_PASSWORD=ai_estimator_migration_test_password MIGRATION_TEST_ADMIN_DATABASE=ai_estimator_migration_admin TS_NODE_PROJECT=api/tsconfig.app.json node -r ts-node/register -r tsconfig-paths/register api/src/database/scripts/baseline-migration-smoke-test.ts",
    "test:api:integration": "MIGRATION_VALIDATION_TARGET=disposable-postgres-migration-validation MIGRATION_TEST_CONTAINER=ai-estimates-migration-test-db MIGRATION_TEST_HOST=127.0.0.1 MIGRATION_TEST_PORT=55432 MIGRATION_TEST_USERNAME=ai_estimator_migration_test MIGRATION_TEST_PASSWORD=ai_estimator_migration_test_password MIGRATION_TEST_ADMIN_DATABASE=ai_estimator_migration_admin jest --config api/jest.integration.config.ts --runInBand",
    "lint": "node ./node_modules/nx/bin/nx.js run-many --target=lint --all",
    "lint:api": "node ./node_modules/nx/bin/nx.js lint api",
    "lint:web": "node ./node_modules/nx/bin/nx.js lint web",
    "test": "node ./node_modules/nx/bin/nx.js run-many --target=test --all",
    "test:api": "node ./node_modules/nx/bin/nx.js test api",
    "simulate:calibration": "TS_NODE_PROJECT=api/tsconfig.app.json node -r ts-node/register -r tsconfig-paths/register api/src/modules/estimate-feedback/testing/calibration-simulation.ts",
    "test:web": "node ./node_modules/nx/bin/nx.js test web",
    "test:e2e:api": "node ./node_modules/nx/bin/nx.js e2e api-e2e",
    "test:e2e:web": "node ./node_modules/nx/bin/nx.js e2e web-e2e",
    "format": "prettier --write \"{api,web}/**/*.ts\" \"{api,web}/**/*.tsx\""
  },
  "private": true,
  "dependencies": {
    "@mantine/core": "^8.2.1",
    "@mantine/form": "^8.2.1",
    "@mantine/hooks": "^8.2.1",
    "@mantine/notifications": "^8.2.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
