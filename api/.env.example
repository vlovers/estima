# Application
PORT=3000
# Direct API development defaults to this origin. Comma-separated exact origins;
# no wildcards or trailing slashes. Production should use its HTTPS frontend.
# Local Compose sets http://localhost,http://localhost:4200 separately; override
# that setting in the shell or project-root .env (not this api/.env file).
CORS_ORIGINS=http://localhost:4200

# Database
POSTGRES_HOST=postgres
POSTGRES_DB=estima
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5432
POSTGRES_USER=admin

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# TypeORM migrations
# Use "baseline" for fresh installations. Existing databases should stay on
# their current chain until they are explicitly reconciled.
TYPEORM_MIGRATION_CHAIN=baseline
